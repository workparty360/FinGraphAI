# ==============================================================================
# FinGraph AI — Caddy Reverse Proxy Configuration
# Automatic TLS certificates via Let's Encrypt / ZeroSSL
# Supports HTTP-to-HTTPS redirect, WebSocket proxying, and security headers
# ==============================================================================

{$APP_DOMAIN:localhost} {
    # Automatic HTTP-to-HTTPS redirect is enabled by default in Caddy

    # Security Headers
    header {
        # Protect against clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Protect against MIME sniffing
        X-Content-Type-Options "nosniff"
        # XSS Protection
        X-XSS-Protection "1; mode=block"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Remove Server disclosure header
        -Server
    }

    # Proxy to Streamlit application on internal Docker network
    reverse_proxy app:8501 {
        # Streaming and WebSocket support for interactive Streamlit UI
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Generous timeouts for long-running AI queries
        flush_interval -1
    }

    # Logging
    log {
        output stdout
        format json
    }
}
