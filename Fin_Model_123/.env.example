# ==============================================================================
# FinGraph AI — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your specific credentials.
# NEVER commit the actual .env file or real API keys to version control.
# ==============================================================================

# Application Environment & Domain
NODE_ENV=production
APP_DOMAIN=finance.example.com
PORT=8501
WORKSPACE_TENANT_ID=production-tenant
DEFAULT_USER_ID=demo-user

# AI API Key Slots (3 configurable keys with sequential failover)
AI_API_KEY_1=gsk_your_groq_api_key_slot_1
AI_API_KEY_2=gsk_your_groq_api_key_slot_2
AI_API_KEY_3=gsk_your_groq_api_key_slot_3
API_KEY_COOLDOWN_SECS=60
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# FalkorDB Primary Graph Database Configuration
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=financial_knowledge

# Agent Memory Retention Limits (prevents unbounded memory growth)
MAX_RECENT_CHAT_TURNS=20
MAX_EPISODIC_MEMORIES=100
MAX_SEMANTIC_MEMORIES=100
MAX_PROCEDURAL_MEMORIES=30

# Service Diagnostics Cache TTL (seconds)
SERVICE_HEALTH_CACHE_TTL=120

